---
interface Props {
  status?: string;
  title?: string;
  body?: string;
  problemTitle?: string;
  problemBody?: string;
  personasTitle?: string;
  learnerTitle?: string;
  learnerBody?: string;
  entrepreneurTitle?: string;
  entrepreneurBody?: string;
  benefits?: string[];
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
}

const {
  status = "Coming Soon",
  title = "Commitspace",
  body = "A social productivity app built around group body doubling sessions so remote workers and learners can reliably show up and get meaningful work done.",
  problemTitle = "The problem we are solving",
  problemBody = "Remote workers and learners, especially people with ADHD, often feel isolated and struggle to avoid procrastination. Commitspace creates shared momentum and accountability without noisy, unproductive social feeds.",
  personasTitle = "Who Commitspace is for",
  learnerTitle = "The Ambitious Learner",
  learnerBody = "You want to code every day and prepare for interviews, but consistency is hard when no one is expecting you. Commitspace helps you show up and keep the streak going.",
  entrepreneurTitle = "The Solo Entrepreneur",
  entrepreneurBody = "You need accountability to focus on high-impact work, plus lightweight community and networking without wasting time. Commitspace keeps sessions intentional and action-oriented.",
  benefits = [
    "Live group focus sessions that make it easier to start and stay in deep work.",
    "A calm accountability structure designed for consistency, not hustle theater.",
    "Small, purposeful communities where progress and connection reinforce each other.",
  ],
  primaryCtaLabel = "Request early access",
  primaryCtaHref = "mailto:hello@volitionlabs.io?subject=Commitspace%20Early%20Access",
  secondaryCtaLabel = "Talk to the team",
  secondaryCtaHref = "mailto:hello@volitionlabs.io?subject=Commitspace%20Question",
} = Astro.props;
---

<section class="product" id="commitspace">
  <div class="container">
    <div class="coming-soon-card">
      <p class="status">{status}</p>
      <h2 class="title">{title}</h2>
      <p class="body">{body}</p>
      <h3 class="subheading">{problemTitle}</h3>
      <p class="problem">{problemBody}</p>
      <h3 class="subheading">{personasTitle}</h3>
      <div class="personas">
        <article class="persona-card">
          <h4>{learnerTitle}</h4>
          <p>{learnerBody}</p>
        </article>
        <article class="persona-card">
          <h4>{entrepreneurTitle}</h4>
          <p>{entrepreneurBody}</p>
        </article>
      </div>
      <ul class="notes">
        {benefits.map((note) => <li>{note}</li>)}
      </ul>
      <div class="cta-row">
        <a href={primaryCtaHref} class="btn-primary">{primaryCtaLabel}</a>
        <a href={secondaryCtaHref} class="btn-secondary">{secondaryCtaLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .product {
    padding: 72px 0 88px;
  }

  .coming-soon-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px;
    max-width: 680px;
  }

  .status {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-green);
    margin-bottom: 10px;
  }

  .title {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .body {
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 22px;
    max-width: 58ch;
  }

  .subheading {
    font-size: 1rem;
    letter-spacing: 0.01em;
    margin-bottom: 8px;
  }

  .problem {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .personas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 20px;
  }

  .persona-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.6);
  }

  .persona-card h4 {
    font-size: 0.94rem;
    margin-bottom: 6px;
  }

  .persona-card p {
    color: var(--text-muted);
    line-height: 1.55;
    font-size: 0.9rem;
  }

  .notes {
    list-style: none;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .notes li {
    position: relative;
    padding-left: 14px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .notes li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent-soft);
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 760px) {
    .personas {
      grid-template-columns: 1fr;
    }
  }
</style>
