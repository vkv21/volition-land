---
interface Props {
  status?: string;
  title?: string;
  body?: string;
  notes?: string[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  status = "Coming Soon",
  title = "Commit Space",
  body = "A focused coworking space for builders, creators, and small teams who want consistency over noise.",
  notes = [
    "Private early access opens soon.",
    "Built by Volition Labs.",
    "No hype. Just steady progress.",
  ],
  ctaLabel = "Join the early list",
  ctaHref = "mailto:hello@volitionlabs.io?subject=Commit%20Space%20Early%20Access",
} = Astro.props;
---

<section class="product" id="commitspace">
  <div class="container">
    <div class="coming-soon-card">
      <p class="status">{status}</p>
      <h2 class="title">{title}</h2>
      <p class="body">{body}</p>
      <ul class="notes">
        {notes.map((note) => <li>{note}</li>)}
      </ul>
      <a href={ctaHref} class="btn-primary">{ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .product {
    padding: 72px 0 88px;
  }

  .coming-soon-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px;
    max-width: 680px;
  }

  .status {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .title {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .body {
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 22px;
    max-width: 58ch;
  }

  .notes {
    list-style: none;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .notes li {
    position: relative;
    padding-left: 14px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .notes li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
</style>
