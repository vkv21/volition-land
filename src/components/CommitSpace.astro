---
interface Props {
  status?: string;
  title?: string;
  body?: string;
  problemTitle?: string;
  problemBody?: string;
  whatIsCards?: Array<{ title: string; body: string; imageSrc?: string; imageAlt?: string }>;
  personasTitle?: string;
  primaryUserTitle?: string;
  primaryUserBody?: string;
  secondaryUserTitle?: string;
  secondaryUserBody?: string;
  benefits?: string[];
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
}

const {
  status = "Coming soon",
  title = "Commitspace",
  body = "Commitspace helps remote workers and primaryUsers start, focus, and finish together.",
  problemTitle = "Why it matters",
  problemBody = "Working alone is hard. Commitspace adds lightweight accountability without distracting social noise.",
  whatIsCards = [
    {
      title: "Deep Work",
      body: "Protect focused time to make progress on meaningful tasks without context switching.",
    },
    {
      title: "Community",
      body: "Stay accountable in low-noise groups that care about progress over performance.",
    },
    {
      title: "Execution Rituals",
      body: "Use simple session rituals to start quickly, commit to goals, and finish consistently.",
    },
    {
      title: "Momentum Tracking",
      body: "Build confidence by stacking completed sessions into a reliable work habit.",
    },
  ],
  personasTitle = "Who it is for",
  primaryUserTitle = "Deep Work",
  primaryUserBody = "Build a daily coding habit and stay interview-ready with consistent sessions.",
  secondaryUserTitle = "High-Impact Work",
  secondaryUserBody = "Protect deep-work time and stay accountable on high-impact tasks.",
  benefits = [
    "Live focus sessions that make starting easier.",
    "Low-noise accountability built for consistency.",
    "Small communities centered on progress.",
  ],
  primaryCtaLabel = "Join early access",
  primaryCtaHref = "mailto:hello@volitionlabs.io?subject=Commitspace%20Early%20Access",
  secondaryCtaLabel = "Talk to the team",
  secondaryCtaHref = "mailto:hello@volitionlabs.io?subject=Commitspace%20Question",
} = Astro.props;
---

<section class="product" id="commitspace">
  <div class="container">
    <div class="coming-soon-card">
      <p class="status">{status}</p>
      <h2 class="title">{title}</h2>
      <div class="body-copy">
        <p class="body">{body}</p>
      </div>
      <h3 class="subheading">{problemTitle}</h3>
      <p class="problem">{problemBody}</p>
      <div class="what-is-cards">
        {whatIsCards.map((card) => (
          <article class="feature-card">
            {card.imageSrc?.trim() ? (
              <img
                class="feature-card-media"
                src={card.imageSrc}
                alt={card.imageAlt ?? ""}
                loading="lazy"
              />
            ) : (
              <div class="feature-card-media feature-card-media--blank" aria-hidden="true" />
            )}
            <h4>{card.title}</h4>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
      <h3 class="subheading">{personasTitle}</h3>
      <div class="personas">
        <article class="persona-card">
          <h4>{primaryUserTitle}</h4>
          <p>{primaryUserBody}</p>
        </article>
        <article class="persona-card">
          <h4>{secondaryUserTitle}</h4>
          <p>{secondaryUserBody}</p>
        </article>
      </div>
      <ul class="notes">
        {benefits.map((note) => <li>{note}</li>)}
      </ul>
      <div class="cta-row">
        <a href={primaryCtaHref} class="btn-primary">{primaryCtaLabel}</a>
        <a href={secondaryCtaHref} class="btn-secondary">{secondaryCtaLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .product {
    padding: 72px 0 88px;
  }

  .coming-soon-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px;
    width: 100%;
    display: grid;
    gap: 20px;
  }

  .status {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-green);
  }

  .title {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .body {
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 58ch;
    margin: 0;
  }

  .body-copy :global(p) {
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 58ch;
    margin: 0;
  }

  .body-copy :global(p + p) {
    margin-top: 0.9em;
  }

  .subheading {
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .problem {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .what-is-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .personas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .feature-card,
  .persona-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    background: var(--surface-soft);
  }

  .feature-card {
    overflow: hidden;
  }

  .feature-card h4,
  .persona-card h4 {
    font-size: 0.94rem;
    margin-bottom: 6px;
  }

  .feature-card p,
  .persona-card p {
    color: var(--text-muted);
    line-height: 1.55;
    font-size: 0.9rem;
  }

  .feature-card-media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 150px;
    border-radius: 8px;
    border: 1px solid var(--border);
    margin-bottom: 10px;
    box-sizing: border-box;
  }

  .feature-card-media:not(.feature-card-media--blank) {
    object-fit: cover;
  }

  .feature-card-media--blank {
    background: var(--surface);
    flex-shrink: 0;
  }

  .notes {
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .notes li {
    position: relative;
    padding-left: 14px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .notes li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent-soft);
  }

  .cta-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 12px;
    justify-content: start;
  }

  @media (max-width: 560px) {
    .cta-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .what-is-cards,
    .personas {
      grid-template-columns: 1fr;
    }
  }
</style>
