---
interface Props {
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;
---

<footer>
  <div class="container footer-inner">
    <span class="logo">Volition Labs</span>
    <span class="footer-copy">&copy; {year} Volition Labs</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 28px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .logo {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
</style>
