---
interface Props {
  headline?: string;
  subtext?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  headline = "Build consistency with others. Build meaningful work together.",
  subtext = "Volition Labs is an R&D studio helping people live and work more intentionally. We are building Commitspace, a social productivity app for focused group body doubling sessions.",
  primaryLabel = "Join Commitspace early access",
  primaryHref = "#commitspace",
  secondaryLabel = "Work with Volition Labs",
  secondaryHref = "#work-with-us",
} = Astro.props;
---

<section class="hero">
  <div class="container">
    <p class="hero-kicker">From Volition Labs</p>
    <h1 class="hero-headline">{headline}</h1>
    <p class="hero-sub">{subtext}</p>
    <div class="hero-actions">
      <a href={primaryHref} class="btn-primary">{primaryLabel}</a>
      <a href={secondaryHref} class="btn-secondary">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 88px 0 72px;
    border-bottom: 1px solid var(--border);
  }

  .hero-kicker {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-green);
    margin-bottom: 14px;
  }

  .hero-headline {
    max-width: 740px;
    font-size: clamp(2rem, 4.1vw, 3.4rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.75;
    margin-bottom: 30px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
